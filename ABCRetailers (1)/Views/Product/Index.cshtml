@model IEnumerable<ABCRetailers.Models.Product>
@{
    ViewData["Title"] = "Products";
    var userRole = Context.Session.GetString("Role");
    var isAdmin = userRole == "Admin";
    var isCustomer = userRole == "Customer";
}

@if (isAdmin)
{
    <!-- Admin View - Table Layout -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-box"></i> Manage Products</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add New Product
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Image</th>
                        <th>Product ID</th>
                        <th>Product Name</th>
                        <th>Description</th>
                        <th>Price</th>
                        <th>Stock Available</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="@product.ProductName" class="img-thumbnail" style="width: 50px; height: 50px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="bg-light d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                        <i class="fas fa-image text-muted"></i>
                                    </div>
                                }
                            </td>
                            <td><code>@product.ProductId.Substring(0, 8)...</code></td>
                            <td>@product.ProductName</td>
                            <td>@(product.Description.Length > 50 ? product.Description.Substring(0, 50) + "..." : product.Description)</td>
                            <td>
                                @if (product.Price > 0)
                                {
                                    <strong class="text-success">@product.Price.ToString("C", System.Globalization.CultureInfo.CreateSpecificCulture("en-US"))</strong>
                                }
                                else
                                {
                                    <strong class="text-danger">@product.Price.ToString("C", System.Globalization.CultureInfo.CreateSpecificCulture("en-US"))</strong>
                                    <br />
                                    <small class="text-danger">⚠️ Price not set</small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-@(product.StockAvailable > 10 ? "success" : product.StockAvailable > 0 ? "warning" : "danger")">
                                    @product.StockAvailable
                                </span>
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@product.RowKey" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDelete('@product.RowKey', '@product.ProductName')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No products found.
            <a asp-action="Create" class="alert-link">Add your first product</a>!
        </div>
    }
}
else if (isCustomer)
{
    <!-- Customer View - Card Layout for Browsing -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-box"></i> Browse Products</h2>
        <a href="@Url.Action("Index", "Cart")" class="btn btn-success">
            <i class="fas fa-shopping-cart"></i> View My Cart
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var product in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" class="card-img-top" alt="@product.ProductName" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="fas fa-image fa-3x text-muted"></i>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@product.ProductName</h5>
                            <p class="card-text">@product.Description</p>
                            <p class="card-text">
                                @if (product.Price > 0)
                                {
                                    <strong class="text-success">Price: @product.Price.ToString("C", System.Globalization.CultureInfo.CreateSpecificCulture("en-US"))</strong>
                                }
                                else
                                {
                                    <strong class="text-danger">Price: @product.Price.ToString("C", System.Globalization.CultureInfo.CreateSpecificCulture("en-US"))</strong>
                                    <br />
                                    <small class="text-danger">Price not available</small>
                                }
                            </p>
                            <p class="card-text">
                                Stock:
                                <span class="badge @(product.StockAvailable > 10 ? "bg-success" : product.StockAvailable > 0 ? "bg-warning" : "bg-danger")">
                                    @product.StockAvailable
                                </span>
                            </p>
                        </div>
                        <div class="card-footer">
                            <form asp-action="AddToCart" asp-controller="Cart" method="post" class="d-inline w-100">
                                <input type="hidden" name="productId" value="@product.RowKey" />
                                <div class="input-group">
                                    <input type="number" name="quantity" value="1" min="1" max="@product.StockAvailable" class="form-control" style="width: 80px;">
                                    <button type="submit" class="btn btn-success" @(product.StockAvailable == 0 ? "disabled" : "")>
                                        <i class="fas fa-cart-plus"></i> Add to Cart
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No products available at the moment.
        </div>
    }
}
else
{
    <!-- Guest View -->
    <div class="text-center">
        <h2><i class="fas fa-box"></i> Our Products</h2>
        <p class="lead">Please login to browse and purchase our products</p>
        <a href="@Url.Action("Login", "Login")" class="btn btn-primary me-2">
            <i class="fas fa-sign-in-alt"></i> Login
        </a>
        <a href="@Url.Action("Register", "Login")" class="btn btn-success">
            <i class="fas fa-user-plus"></i> Register
        </a>
    </div>
}

@if (isAdmin)
{
    <!-- Delete Confirmation Modal (Admin Only) -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete product <strong id="productName"></strong>?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form id="deleteForm" method="post" style="display: inline;">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (isAdmin)
    {
        <script>
            function confirmDelete(productId, productName) {
                document.getElementById('productName').textContent = productName;
                document.getElementById('deleteForm').action = '/Product/Delete/' + productId;
                new bootstrap.Modal(document.getElementById('deleteModal')).show();
            }
        </script>
    }
}