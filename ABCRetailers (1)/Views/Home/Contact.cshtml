@{
    ViewData["Title"] = "Contact Us";
}

<div class="max-w-5xl mx-auto p-6">
    <h1 class="text-4xl font-bold mb-6 text-center text-primary">@ViewData["Title"]</h1>

    <!-- Contact Info -->
    <div class="bg-white shadow-md rounded-2xl p-6 mb-6">
        <h2 class="text-2xl font-semibold mb-4 text-blue-700">Get in Touch</h2>
        <p><strong>Address:</strong> 144 Peter Rd, Johannesburg, South Africa</p>
        <p><strong>Email:</strong> <a href="mailto:ntoks@abcretailers.com" class="text-blue-600 underline">ntoks@abcretailers.com</a></p>
        <p><strong>Phone:</strong> +27 56 657 4007</p>
    </div>

    <!-- Operational Hours -->
    <div class="bg-white shadow-md rounded-2xl p-6 mb-6">
        <h2 class="text-2xl font-semibold mb-4 text-blue-700">Operational Hours</h2>
        <table class="table table-bordered text-center">
            <thead class="table-light">
                <tr>
                    <th>Day</th>
                    <th>Hours</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>Monday - Friday</td><td>08:00 - 18:00</td></tr>
                <tr><td>Saturday</td><td>09:00 - 15:00</td></tr>
                <tr><td>Sunday & Public Holidays</td><td>Closed</td></tr>
            </tbody>
        </table>
    </div>

    <!-- Google Form -->
    <div class="bg-white shadow-md rounded-2xl p-6 mb-6">
        <h2 class="text-2xl font-semibold mb-4 text-blue-700">Send us an Enquiry</h2>
        <div class="relative overflow-hidden rounded-xl" style="height: 700px;">
            <iframe src="https://docs.google.com/forms/d/e/1FAIpQLSfS0lMp4_2i6FrxsWexPi8YEgBEykM2UEJK0DFP85uneLYjbQ/viewform?embedded=true"
                    width="100%" height="100%" frameborder="0" marginheight="0" marginwidth="0"
                    class="rounded-xl">
                Loading…
            </iframe>
        </div>
    </div>

    <!-- Google Maps -->
    <div class="bg-white shadow-md rounded-2xl p-6 mb-6">
        <h2 class="text-2xl font-semibold mb-4 text-blue-700">Our Location</h2>
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3583.4770471853158!2d27.873880075411215!3d-26.08334197715115!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1e959ef5277b96a7%3A0xc4aa15508f8e5e8c!2sIIE%20MSA!5e0!3m2!1sen!2sza!4v1757772144761!5m2!1sen!2sza"
                width="100%" height="400" style="border:0;" allowfullscreen="" loading="lazy"
                class="rounded-xl">
        </iframe>
    </div>

    <!-- Back Button -->
    <div class="text-center mt-8">
        <a asp-controller="Home" asp-action="Index" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-full shadow-md transition">
            ⬅ Back to Home
        </a>
    </div>
</div>
