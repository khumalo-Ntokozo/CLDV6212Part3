@{
    ViewData["Title"] = "Customer Dashboard";
}

<div class="container">
    <h2>Welcome, Customer!</h2>

    <div class="alert alert-info">
        <h4>Happy Shopping!</h4>
        <p>Browse our products and start adding items to your cart.</p>
    </div>

    <div class="row mt-4">
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-body text-center">
                    <i class="fas fa-box fa-3x text-primary mb-3"></i>
                    <h4>Browse Products</h4>
                    <p>Explore our product catalog</p>
                    <a href="@Url.Action("Index", "Product")" class="btn btn-primary">View Products</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-body text-center">
                    <i class="fas fa-shopping-cart fa-3x text-success mb-3"></i>
                    <h4>My Cart</h4>
                    <p>View your shopping cart</p>
                    <a href="@Url.Action("Index", "Cart")" class="btn btn-success">View Cart</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-body text-center">
                    <i class="fas fa-list fa-3x text-warning mb-3"></i>
                    <h4>My Orders</h4>
                    <p>View your order history</p>
                    <a href="@Url.Action("MyOrders", "Order")" class="btn btn-warning">View Orders</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-body text-center">
                    <i class="fas fa-user fa-3x text-info mb-3"></i>
                    <h4>My Profile</h4>
                    <p>Manage your account</p>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-info">Go to Home</a>
                </div>
            </div>
        </div>
    </div>
</div>