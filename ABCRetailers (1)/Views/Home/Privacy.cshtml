@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="max-w-5xl mx-auto p-6">
    <h1 class="text-4xl font-bold mb-6 text-center">@ViewData["Title"]</h1>

    <p class="text-gray-700 text-lg leading-relaxed mb-8 text-center">
        ABC Retailers is committed to protecting the privacy of our customers. This privacy
        policy outlines how we collect, use, and safeguard your personal information when you
        shop on our website.
    </p>

    <!-- Section Card -->
    <div class="bg-white shadow-md rounded-2xl p-6 mb-6">
        <h2 class="text-2xl font-semibold mb-4 text-blue-700">Information We Collect</h2>
        <ul class="list-disc list-inside space-y-2 text-gray-700">
            <li><strong>Personal Information:</strong> Name, email address, phone number, and shipping address.</li>
            <li><strong>Payment Information:</strong> Credit card numbers and other payment details.</li>
            <li><strong>Browsing Information:</strong> IP address, browser type, and device type.</li>
        </ul>
    </div>

    <div class="bg-white shadow-md rounded-2xl p-6 mb-6">
        <h2 class="text-2xl font-semibold mb-4 text-blue-700">How We Use Your Information</h2>
        <ul class="list-disc list-inside space-y-2 text-gray-700">
            <li><strong>Order Fulfillment:</strong> To process and deliver your orders.</li>
            <li><strong>Communication:</strong> To provide updates, promotions, and notifications about your orders.</li>
            <li><strong>Marketing:</strong> To send promotional emails (with the option to opt-out).</li>
            <li><strong>Analytics:</strong> To analyze traffic and improve our services.</li>
        </ul>
    </div>

    <div class="bg-white shadow-md rounded-2xl p-6 mb-6">
        <h2 class="text-2xl font-semibold mb-4 text-blue-700">Information Sharing</h2>
        <ul class="list-disc list-inside space-y-2 text-gray-700">
            <li><strong>Service Providers:</strong> Payment processors and shipping companies.</li>
            <li><strong>Partners:</strong> Affiliates and promotional partners.</li>
            <li><strong>Legal Requirements:</strong> If required by law or to protect our rights.</li>
        </ul>
    </div>

    <div class="bg-white shadow-md rounded-2xl p-6 mb-6">
        <h2 class="text-2xl font-semibold mb-4 text-blue-700">Security Measures</h2>
        <ul class="list-disc list-inside space-y-2 text-gray-700">
            <li><strong>Encryption:</strong> Protecting your payment information.</li>
            <li><strong>Secure Servers:</strong> Personal information stored on secure servers with firewalls.</li>
            <li><strong>Access Control:</strong> Limited access to authorized personnel only.</li>
        </ul>
    </div>

    <div class="bg-white shadow-md rounded-2xl p-6 mb-6">
        <h2 class="text-2xl font-semibold mb-4 text-blue-700">Your Rights</h2>
        <ul class="list-disc list-inside space-y-2 text-gray-700">
            <li><strong>Access:</strong> Update your information by logging into your account.</li>
            <li><strong>Opt-out:</strong> Unsubscribe from marketing emails anytime.</li>
            <li><strong>Delete:</strong> Request deletion of your account and personal data.</li>
        </ul>
    </div>

    <div class="bg-white shadow-md rounded-2xl p-6 mb-6">
        <h2 class="text-2xl font-semibold mb-4 text-blue-700">Changes to this Policy</h2>
        <p class="text-gray-700 leading-relaxed">
            We may update this policy from time to time. We will notify you of changes by posting the updated version on our website.
        </p>
    </div>

    <!-- Map -->
    <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white shadow-md rounded-2xl p-4">
            <h2 class="text-xl font-semibold mb-3 text-blue-700">Learn More</h2>
            <iframe width="100%" height="315"
                    src="https://www.youtube.com/embed/YmzatOYykHw?si=Q5HWAWArit6V-xYy"
                    title="YouTube video player"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen>
            </iframe>
        </div>

    <!-- Back Button -->
    <div class="text-center mt-8">
        <a href="/" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-full shadow-md transition">
            ⬅ Back to Home
        </a>
    </div>
</div>
